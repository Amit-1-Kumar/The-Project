# .env.example
# Copy this file to .env and update with your actual values

# ========== SERVER ==========
NODE_ENV=production
PORT=3000
HOST=localhost

# ========== DATABASE ==========
# PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=printer_leads
DB_USER=postgres
DB_PASSWORD=your_password

# MongoDB (alternative)
# DB_TYPE=mongodb
# MONGODB_URI=mongodb://localhost:27017/printer-leads

# MySQL (alternative)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=printer_leads
# DB_USER=root
# DB_PASSWORD=your_password

# ========== CONTACT INFO ==========
WHATSAPP_NUMBER=919876543210
PHONE_NUMBER=919876543210
SUPPORT_EMAIL=support@example.com
LEAD_EMAIL=leads@example.com

# ========== API KEYS - TWILIO (WhatsApp/SMS) ==========
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1234567890
TWILIO_WHATSAPP=whatsapp:+1234567890

# ========== API KEYS - EMAIL ==========
# SendGrid
SENDGRID_API_KEY=your_sendgrid_key

# Mailgun
MAILGUN_DOMAIN=mail.example.com
MAILGUN_API_KEY=your_mailgun_key

# Gmail (SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_app_password

# ========== CRM INTEGRATION ==========
# Pipedrive
PIPEDRIVE_API_KEY=your_pipedrive_key
PIPEDRIVE_DEAL_STAGE=1
PIPEDRIVE_PERSON_CUSTOM_FIELDS={}

# HubSpot
HUBSPOT_API_KEY=your_hubspot_key

# Salesforce
SALESFORCE_CLIENT_ID=your_client_id
SALESFORCE_CLIENT_SECRET=your_client_secret
SALESFORCE_USERNAME=your_username
SALESFORCE_PASSWORD=your_password

# Zoho
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_ACCESS_TOKEN=your_access_token

# ========== ANALYTICS ==========
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=123456789

# ========== FRONTEND URL ==========
FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# ========== JWT (For Admin Dashboard) ==========
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRY=7d

# ========== SECURITY ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_KEY_EXTERNAL=your_api_key_for_external_access

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ========== DEBUG MODE ==========
DEBUG=false
VERBOSE_LOGGING=false

# ========== WEBHOOK ==========
# Send data to external service
WEBHOOK_URL=https://your-webhook-service.com/webhook
WEBHOOK_ENABLED=false

# ========== NOTIFICATION SETTINGS ==========
# Auto-notify admin on new lead
NOTIFY_ADMIN_ON_LEAD=true
# Send welcome message to customer
SEND_WELCOME_MESSAGE=true
# Mark lead as read after x hours
AUTO_ARCHIVE_AFTER_HOURS=72
